# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# use open ssl hex2bin to create keys
#  openssl rand -hex 64
encryption.key = 
API_MASTER_SECRET = 
JWT_SECRET_KEY = 

